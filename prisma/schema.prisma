generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  hashedPassword String
  name           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subjects       Subject[]
  studyUnits     StudyUnit[]
  quizResults    QuizResult[]
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id         String      @id @default(cuid())
  name       String
  color      String      @default("#3b82f6")
  icon       String      @default("book")
  userId     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyUnits StudyUnit[]

  @@index([userId])
}

model StudyUnit {
  id              String       @id @default(cuid())
  subjectId       String
  userId          String
  title           String       @default("Lerneinheit")
  imageCloudPath  String?
  imageIsPublic   Boolean      @default(false)
  summary         String       @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       Question[]
  quizResults     QuizResult[]

  @@index([userId])
  @@index([subjectId])
}

enum QuestionType {
  OPEN
  MULTIPLE_CHOICE
}

model Question {
  id            String       @id @default(cuid())
  studyUnitId   String
  type          QuestionType
  questionText  String       @db.Text
  sampleAnswer  String?      @db.Text
  options       Json?        
  correctOption Int?
  createdAt     DateTime     @default(now())
  studyUnit     StudyUnit    @relation(fields: [studyUnitId], references: [id], onDelete: Cascade)

  @@index([studyUnitId])
}

model QuizResult {
  id          String    @id @default(cuid())
  userId      String
  studyUnitId String
  score       Int
  total       Int
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyUnit   StudyUnit @relation(fields: [studyUnitId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([studyUnitId])
}
